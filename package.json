{
  "name": "infinitecampus-mcp",
  "version": "2.8.4",
  "mcpName": "io.github.chrischall/infinitecampus-mcp",
  "description": "Infinite Campus (Campus Parent) MCP server — multi-district read + message/document write",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/infinitecampus-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "infinite-campus",
    "campus-parent",
    "school",
    "education",
    "k12",
    "grades",
    "attendance",
    "assignments"
  ],
  "type": "module",
  "bin": {
    "infinitecampus-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "dev": "node --env-file=.env dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.26.1",
    "@fetchproxy/bootstrap": "^2.2.0",
    "@fetchproxy/server": "^2.11.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "node-html-parser": "^9.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
